# Kopia dla samodzielnego uruchomienia backendu bez Dockera (npm run dev).
# Do uruchomienia przez docker-compose służy .env w katalogu głównym repo.

NODE_ENV=development

# --- Baza danych ---
DATABASE_URL="mysql://skarbnik:skarbnik@localhost:3306/skarbnik"

# --- Sesje ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Sieć / TLS ---
# Lokalnie zwykle appka NIE terminuje TLS sama (ruch idzie po HTTP, ewentualny
# reverse proxy dokłada HTTPS z zewnątrz). Na VPS/za NGINX Proxy Managerem
# zostaw ENABLE_HTTPS=false i TRUST_PROXY=true.
APP_PORT=4000
ENABLE_HTTPS=false
APP_HTTPS_PORT=4443
SSL_CERT_PATH=
SSL_KEY_PATH=
TRUST_PROXY=false
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# --- Logowanie / tymczasowa blokada konta ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_STAGES_MINUTES=15,60,1440
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Konto administratora tworzone przez `npm run prisma:seed` ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ZmienMniePoPierwszymLogowaniu!1
ADMIN_DISPLAY_NAME=Skarbnik

# --- Autor/wersja/data publikacji (informacyjne, patrz /api/health i
# stopka w Ustawieniach) ---
APP_AUTHOR=wachcio
APP_VERSION=1.0.0
APP_RELEASE_DATE=2026-09-10
