# Zmienne dla docker-compose (całe środowisko: mysql + backend + frontend).
# Skopiuj do .env i uzupełnij prawdziwymi wartościami — .env jest w .gitignore.
#
# Ten sam plik pozwala przełączyć appkę z domowego NGINX Proxy Managera
# (lokalny CA, TRUST_PROXY=true, ENABLE_HTTPS=false) na VPS + NPM (certyfikat
# publiczny, te same ustawienia), na VPS BEZ NPM (profil `standalone-proxy`
# w docker-compose.yml — własny nginx+certbot z tego repo, patrz APP_DOMAIN/
# LETSENCRYPT_EMAIL niżej i README.md) albo na samodzielne HTTPS appki
# (ENABLE_HTTPS=true + ścieżki do certów) — bez zmian w kodzie.

# --- Baza danych (MySQL) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=skarbnik
MYSQL_USER=skarbnik
MYSQL_PASSWORD=change-me

# --- Backend ---
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string
APP_PORT=4000

# TLS: false + TRUST_PROXY=true = appka za NGINX Proxy Managerem (dom/VPS).
# true = appka sama terminuje HTTPS (wymaga zamontowanych certów w /certs).
ENABLE_HTTPS=false
SSL_CERT_PATH=/certs/fullchain.pem
SSL_KEY_PATH=/certs/privkey.pem
TRUST_PROXY=true

PUBLIC_BASE_URL=https://skarbnik.przyklad-domena.pl
CORS_ORIGIN=https://skarbnik.przyklad-domena.pl

# Tylko dla wariantu BEZ NGINX Proxy Managera (usługi nginx/certbot w
# docker-compose.yml, profil `standalone-proxy` — patrz README.md).
# APP_DOMAIN musi być tą samą domeną co PUBLIC_BASE_URL/CORS_ORIGIN wyżej
# (bez https:// i bez ścieżki). LETSENCRYPT_EMAIL to adres, na który
# certbot wyśle powiadomienie, gdyby certyfikat kiedyś nie odnowił się
# automatycznie.
APP_DOMAIN=skarbnik.przyklad-domena.pl
LETSENCRYPT_EMAIL=ty@przyklad-domena.pl

# Ochrona logowania — patrz PROJECT.md
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_STAGES_MINUTES=15,60,1440
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Konto administratora tworzone przy pierwszym seedowaniu bazy
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ZmienMniePoPierwszymLogowaniu!1
ADMIN_DISPLAY_NAME=Skarbnik

# Autor/wersja/data publikacji — czysto informacyjne, appka je tylko
# dyskretnie wyświetla (stopka w Ustawieniach), niczego nie zmieniają.
APP_AUTHOR=wachcio
APP_VERSION=1.0.0
APP_RELEASE_DATE=2026-09-10

# --- Frontend ---
# Frontend woła zawsze względne /api (ten sam origin) — nie ma tu osobnej
# zmiennej z adresem API. WYMAGANE: w NGINX Proxy Managerze na Proxy Hoście
# dla PUBLIC_BASE_URL dodaj Custom Location "/api" -> backend:4000 (scheme
# http, TLS i tak kończy NPM). Bez tego logowanie zwróci błąd połączenia.
#
# FRONTEND_PORT/APP_PORT (wyżej) to tylko publikacja na hosta — przydatna
# do debugowania (`curl localhost:5173`) albo gdy Twój reverse proxy (NPM)
# łączy się przez host, a nie przez sieć Dockera appki. W wariancie BEZ NPM
# (profil `standalone-proxy`) nowy kontener `nginx` i tak gada z frontendem
# i backendem po wewnętrznej sieci Dockera, po ich stałych portach
# kontenerowych (frontend:5173, backend:4000) — więc te dwie zmienne możesz
# śmiało zostawić na domyślnych wartościach, nic więcej nie trzeba tu zmieniać.
FRONTEND_PORT=5173
